# ============================================
#  Zsh Configuration
# ============================================
BREW_PREFIX="/opt/homebrew"

# ── 히스토리 ──
HISTFILE=~/.zsh_history
HISTSIZE=50000
SAVEHIST=50000
setopt SHARE_HISTORY          # 탭 간 히스토리 공유
setopt HIST_IGNORE_ALL_DUPS   # 중복 제거
setopt HIST_REDUCE_BLANKS
setopt EXTENDED_HISTORY

# ── 기본 동작 ──
setopt AUTO_CD                # `..` 만 쳐도 이동
setopt INTERACTIVE_COMMENTS

# ── 자동완성 (compinit은 다른 것들보다 먼저) ──
fpath=(~/.zsh/completions "$BREW_PREFIX/share/zsh/site-functions" $fpath)
autoload -Uz compinit
compinit -C                   # -C: 캐시 사용, 시작 속도 향상
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'   # 대소문자 무시

# ============================================
#  도구 초기화
# ============================================
# 런타임 버전 관리
eval "$(mise activate zsh)"

# 프롬프트
eval "$(starship init zsh)"

# fzf — Ctrl+R 히스토리, Ctrl+T 파일 검색
source <(fzf --zsh)

# zoxide — cd는 그대로 두고 z / zi 만 추가
eval "$(zoxide init zsh)"

# ============================================
#  환경변수
# ============================================
export CLICOLOR=1
export EDITOR="vim"
export MANPAGER="sh -c 'col -bx | bat -l man -p'"   # man 페이지만 bat

# rg 기본 설정
export RIPGREP_CONFIG_PATH="$HOME/.ripgreprc"

# ============================================
#  별칭 — 기본 명령어는 하나도 안 건드림
# ============================================
alias k="kubectl"
alias g="git"

# ============================================
#  플러그인 (이 순서 지킬 것)
# ============================================
source "$BREW_PREFIX/share/zsh-autosuggestions/zsh-autosuggestions.zsh"
ZSH_AUTOSUGGEST_STRATEGY=(history completion)

# ── Tab: 단어 단위 수락 / Shift+Tab: 전체 수락 ──
ZSH_AUTOSUGGEST_PARTIAL_ACCEPT_WIDGETS=(forward-word emacs-forward-word)
_tab_partial_or_complete() {
  local b="$BUFFER"
  zle forward-word
  [[ "$BUFFER" == "$b" ]] && zle fzf-completion
}
zle -N _tab_partial_or_complete
bindkey '^I' _tab_partial_or_complete
bindkey '^[[Z' autosuggest-accept

compdef k=kubectl

# fast-syntax-highlighting은 반드시 맨 마지막
source "$BREW_PREFIX/opt/zsh-fast-syntax-highlighting/share/zsh-fast-syntax-highlighting/fast-syntax-highlighting.plugin.zsh"
