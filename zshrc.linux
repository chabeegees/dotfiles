# ── 히스토리 ──
HISTFILE=~/.zsh_history
HISTSIZE=50000
SAVEHIST=50000
setopt SHARE_HISTORY HIST_IGNORE_ALL_DUPS EXTENDED_HISTORY
setopt AUTO_CD INTERACTIVE_COMMENTS

# ── 자동완성 ──
autoload -Uz compinit && compinit -C
zmodload zsh/complist
zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'
bindkey '^[[Z' reverse-menu-complete
LISTMAX=50

# ── 도구 ──
command -v starship >/dev/null && eval "$(starship init zsh)"
command -v zoxide   >/dev/null && eval "$(zoxide init zsh)"
[ -f ~/.fzf.zsh ] && source ~/.fzf.zsh

export EDITOR=vim
export CLICOLOR=1
alias k="kubectl"

# ── 플러그인 (경로가 배포판마다 달라서 둘 다 시도) ──
for p in /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh \
         ~/.zsh/zsh-autosuggestions/zsh-autosuggestions.zsh; do
  [ -f "$p" ] && source "$p" && break
done
for p in /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh \
         ~/.zsh/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh; do
  [ -f "$p" ] && source "$p" && break
done
