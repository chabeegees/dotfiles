# 원격 환경에서 알 수 없는 TERM이면 안전한 값으로 대체
if ! infocmp "$TERM" >/dev/null 2>&1; then
  export TERM=xterm-256color
fi

# ── 히스토리 ──
HISTFILE=~/.zsh_history
HISTSIZE=50000
SAVEHIST=50000
setopt SHARE_HISTORY HIST_IGNORE_ALL_DUPS EXTENDED_HISTORY
setopt AUTO_CD INTERACTIVE_COMMENTS

# ── 자동완성 ──
autoload -Uz compinit && compinit -C
zmodload zsh/complist
zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'
bindkey '^[[Z' reverse-menu-complete
LISTMAX=50

# ── 도구 ──
command -v starship >/dev/null && eval "$(starship init zsh)"
command -v zoxide   >/dev/null && eval "$(zoxide init zsh)"
[ -f ~/.fzf.zsh ] && source ~/.fzf.zsh

export EDITOR=vim
export CLICOLOR=1
alias k="kubectl"

# ── 플러그인 (각각 한 번만 로드) ──
for p in /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh \
         "$HOME/.zsh/zsh-autosuggestions/zsh-autosuggestions.zsh"; do
  if [ -f "$p" ]; then
    source "$p"
    break
  fi
done

ZSH_AUTOSUGGEST_PARTIAL_ACCEPT_WIDGETS=(forward-word emacs-forward-word)

_tab_partial_or_complete() {
  local b="$BUFFER"
  zle forward-word
  [[ "$BUFFER" == "$b" ]] && zle expand-or-complete
}
zle -N _tab_partial_or_complete
bindkey '^I' _tab_partial_or_complete
bindkey '^[[Z' autosuggest-accept

for p in /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh \
         /usr/share/zsh/plugins/fast-syntax-highlighting/fast-syntax-highlighting.plugin.zsh \
         "$HOME/.zsh/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"; do
  if [ -f "$p" ]; then
    source "$p"
    break
  fi
done

